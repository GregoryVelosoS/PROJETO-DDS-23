<%- include('../partials/header') %>

<div class="container" style="width: 80%; max-width: none;">
    <div class="card" style="padding: 3rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); background-color: var(--cor-fundo);">
        
        <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;">
            <i class="fa-solid fa-user-pen"></i> Editar Conta
        </h2>
        <p style="color: var(--cor-texto-secundario); text-align: center; margin-bottom: 2rem;">
            Atualizando dados de ID: <strong><%= usuario.id %></strong>
        </p>
        
        <!-- Formulário apontando para a Rota de Edição com parâmetro dinâmico -->
        <form action="/usuarios/atualizar/<%= usuario.id %>" method="POST" enctype="multipart/form-data">
            
            <div class="form-grid">
                
                <!-- ============================================== -->
                <!-- EXIBIÇÃO DA FOTO ATUAL DO USUÁRIO (SE EXISTIR) -->
                <!-- ============================================== -->
                <div class="form-group col-full" style="text-align: center; margin-bottom: 20px;">
                    <% if(usuario.foto) { %>
                        <img src="<%= usuario.foto %>" alt="Foto Atual" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 2px solid var(--cor-borda); margin-bottom: 10px;">
                        <p style="font-size: 12px; color: var(--cor-texto-secundario);">Foto Atual</p>
                    <% } else { %>
                        <div style="width: 120px; height: 120px; background: #EEE; border: 2px solid var(--cor-borda); border-radius: 50%; margin: 0 auto 10px auto; display:flex; align-items:center; justify-content:center; color: var(--cor-texto-secundario);">
                            Sem Foto
                        </div>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="nome"><i class="fa-solid fa-id-card"></i> Nome Completo</label>
                    <input type="text" id="nome" name="nome" class="form-control" value="<%= usuario.nome %>" required>
                </div>
                
                <div class="form-group">
                    <label for="telefone"><i class="fa-solid fa-phone"></i> Telefone / WhatsApp</label>
                    <input type="text" id="telefone" name="telefone" class="form-control" value="<%= usuario.telefone %>" required>
                </div>
                
                <div class="form-group">
                    <label for="email"><i class="fa-solid fa-envelope"></i> E-mail</label>
                    <input type="email" id="email" name="email" class="form-control" value="<%= usuario.email %>" required>
                </div>
                
                <div class="form-group">
                    <label for="perfil"><i class="fa-solid fa-users"></i> Papel do Usuário</label>
                    <select id="perfil" name="perfil" class="form-control" required>
                        <option value="ofertante" <%= usuario.perfil === 'ofertante' ? 'selected' : '' %>>Ofertante</option>
                        <option value="interessado" <%= usuario.perfil === 'interessado' ? 'selected' : '' %>>Interessado</option>
                        <option value="administrador" <%= usuario.perfil === 'administrador' ? 'selected' : '' %>>Administrador do Sistema</option>
                    </select>
                </div>
                
                <!-- INPUT TIPO FILE PARA ATUALIZAR A FOTO (SEMPRE POR ÚLTIMO NA GRID) -->
                <div class="form-group col-full">
                    <label for="foto"><i class="fa-solid fa-camera-rotate"></i> Substituir Foto de Perfil (Opcional)</label>
                    <input type="file" id="foto" name="foto" class="form-control" accept="image/*">
                    
                    <div id="preview-box" class="preview-container">
                        <img id="preview-img" src="" alt="Nova Foto">
                    </div>
                </div>

            </div>
            
            <!-- Botões de Ação -->
            <button type="submit" class="btn btn-secondary col-full" style="width: 100%; margin-top: 15px;">
                <i class="fa-solid fa-floppy-disk"></i> Salvar Alterações
            </button>
            <a href="/usuarios" class="btn btn-primary col-full" style="display: block; text-align: center; margin-top: 10px; text-decoration: none;">
                Cancelar e Voltar
            </a>
            
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
