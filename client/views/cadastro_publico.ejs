<%- include('partials/header') %>

<div class="container" style="max-width: 800px;">
    <div class="card" style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); background-color: var(--cor-fundo);">
        <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;">
            <i class="fa-solid fa-user-plus"></i> Criar Nova Conta
        </h2>
        <p style="color: var(--cor-texto-secundario); text-align: center; margin-bottom: 2rem;">Faça parte da nossa comunidade de trocas.</p>
        
        <form action="/usuarios/cadastrar" method="POST" enctype="multipart/form-data">
            
            <div class="form-group">
                <label for="foto"><i class="fa-solid fa-camera"></i> Foto de Perfil</label>
                <input type="file" id="foto" name="foto" class="form-control" accept="image/*" required>
            </div>

            <div class="form-group">
                <label for="nome"><i class="fa-solid fa-id-card"></i> Nome Completo</label>
                <input type="text" id="nome" name="nome" class="form-control" required>
            </div>
            
            <div class="form-group">
                <label for="telefone"><i class="fa-solid fa-phone"></i> Telefone / WhatsApp</label>
                <input type="text" id="telefone" name="telefone" class="form-control" required>
            </div>
            
            <div class="form-group">
                <label for="email"><i class="fa-solid fa-envelope"></i> E-mail</label>
                <input type="email" id="email" name="email" class="form-control" required>
            </div>
            
            <div class="form-group">
                <label for="senha"><i class="fa-solid fa-lock"></i> Senha</label>
                <input type="password" id="senha" name="senha" class="form-control" required>
            </div>
            
            <div class="form-group">
                <label for="perfil"><i class="fa-solid fa-users"></i> Qual o seu papel?</label>
                <select id="perfil" name="perfil" class="form-control" required>
                    <option value="ofertante">Quero Oferecer Produtos</option>
                    <option value="interessado">Estou em busca de Produtos</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 15px;">
                <i class="fa-solid fa-check"></i> Cadastrar Gratuitamente
            </button>
            
            <div style="text-align: center; margin-top: 20px;">
                <a href="/login" style="color: var(--cor-texto-principal); font-weight: bold; text-decoration: none;">
                    Já tem conta? <span style="color: var(--cor-destaque); text-decoration: underline;">Faça Login</span>
                </a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
