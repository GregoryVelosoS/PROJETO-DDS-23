<%- include('partials/header') %>

<div class="container" style="width: 80%; max-width: none;">
    <div class="card" style="margin: 2rem auto; padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); background-color: var(--cor-fundo);">
        <h2 style="color: var(--cor-destaque);">Anunciar Produto</h2>
        <p style="color: var(--cor-texto-secundario); margin-bottom: 2rem;">Publique o item que deseja negociar.</p>
        
        <!-- O enctype multipart/form-data AVISA o Node.js que estamos mandando um arquivo físico via POST -->
        <form action="/produtos/cadastrar" method="POST" enctype="multipart/form-data">
            
            <div class="form-grid">
                <div class="form-group">
                    <label for="nome">Título Breve</label>
                    <input type="text" id="nome" name="nome" class="form-control" placeholder="Ex: Cadeira Gamer" required>
                </div>
                
                <div class="form-group">
                    <label for="preco">Preço Base de Negociação (R$)</label>
                    <input type="number" step="0.01" id="preco" name="preco" class="form-control" required>
                </div>
                
                <div class="form-group col-full">
                    <label for="descricao">Descrição Completa</label>
                    <textarea id="descricao" name="descricao" class="form-control" rows="3" placeholder="Qual o estado físico? Possui marcas de uso?" required></textarea>
                </div>

                <div class="form-group">
                    <label for="condicao">Condição Atual</label>
                    <select id="condicao" name="condicao" class="form-control" required>
                        <option value="novo">Novo</option>
                        <option value="usado">Usado</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="is_publico">Visibilidade no Sistema</label>
                    <select id="is_publico" name="is_publico" class="form-control" required>
                        <option value="1">Público (Liberado na Vitrine)</option>
                        <option value="0">Privado (Apenas Rascunho, Oculto)</option>
                    </select>
                </div>
                
                <!-- FOTO FICA OBRIGATORIAMENTE POR ÚLTIMO, OCUPANDO A LINHA INTEIRA -->
                <div class="form-group col-full">
                    <label for="foto">Foto do Produto (Obrigatória)</label>
                    <input type="file" id="foto" name="foto" class="form-control" accept="image/*" required>
                    
                    <!-- CAIXA DE PREVIEW (Controlada pelo JS) -->
                    <div id="preview-box" class="preview-container">
                        <img id="preview-img" src="" alt="Foto do Produto a Anunciar">
                    </div>
                </div>
            </div>
            
            <button type="submit" class="btn btn-secondary col-full" style="width: 100%; margin-top: 20px;">Postar Produto</button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
