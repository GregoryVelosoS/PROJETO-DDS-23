<%- include('partials/header') %>

<div class="container" style="width: 80%; max-width: none;">
    <!-- Caixa com nosso Design Brutalista -->
    <div class="card" style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); background-color: var(--cor-fundo);">
        
        <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;">
            <i class="fa-solid fa-pen-to-square"></i> Editar Produto
        </h2>
        <p style="color: var(--cor-texto-secundario); text-align: center; margin-bottom: 2rem;">
            Atualizando os dados do item ID: <strong><%= produto.id %></strong>
        </p>
        
        <!-- O Formulário de Edição também requer enctype="multipart" por ter troca de foto -->
        <form action="/produtos/atualizar/<%= produto.id %>" method="POST" enctype="multipart/form-data">
            
            <div class="form-grid">
                
                <!-- EXIBIÇÃO DA FOTO ATUAL DO PRODUTO -->
                <div class="form-group col-full" style="text-align: center; margin-bottom: 15px;">
                    <% if(produto.foto) { %>
                        <img src="<%= produto.foto %>" alt="Foto Atual" style="width: 150px; height: 150px; object-fit: cover; border: 2px solid var(--cor-borda);">
                        <p style="font-size: 12px; color: var(--cor-texto-secundario); margin-top: 5px;">Foto Cadastrada</p>
                    <% } else { %>
                        <div style="width: 150px; height: 150px; background: #EEE; border: 2px solid var(--cor-borda); margin: 0 auto; display:flex; align-items:center; justify-content:center;">Sem Foto</div>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="nome">Título Breve</label>
                    <input type="text" id="nome" name="nome" class="form-control" value="<%= produto.nome %>" required>
                </div>
                
                <div class="form-group">
                    <label for="preco">Preço Base (R$)</label>
                    <input type="number" step="0.01" id="preco" name="preco" class="form-control" value="<%= produto.preco %>" required>
                </div>
                
                <div class="form-group col-full">
                    <label for="descricao">Descrição Completa</label>
                    <!-- Em textareas, o 'value' fica entre a tag de abertura e fechamento -->
                    <textarea id="descricao" name="descricao" class="form-control" rows="3" required><%= produto.descricao %></textarea>
                </div>

                <div class="form-group">
                    <label for="condicao">Condição Atual</label>
                    <select id="condicao" name="condicao" class="form-control" required>
                        <option value="novo" <%= produto.condicao === 'novo' ? 'selected' : '' %>>Novo</option>
                        <option value="usado" <%= produto.condicao === 'usado' ? 'selected' : '' %>>Usado</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="is_publico">Visibilidade no Sistema</label>
                    <select id="is_publico" name="is_publico" class="form-control" required>
                        <!-- Usamos comparadores JS (1 ou 0) do banco MySQL para selecionar a opção -->
                        <option value="1" <%= produto.is_publico ? 'selected' : '' %>>Público (Liberado na Vitrine)</option>
                        <option value="0" <%= !produto.is_publico ? 'selected' : '' %>>Privado (Apenas Rascunho, Oculto)</option>
                    </select>
                </div>
                
                <!-- REGRA MANTIDA: A FOTO É O ÚLTIMO ELEMENTO DO FORM -->
                <div class="form-group col-full">
                    <label for="foto"><i class="fa-solid fa-camera-rotate"></i> Substituir Foto (Opcional)</label>
                    <input type="file" id="foto" name="foto" class="form-control" accept="image/*">
                    
                    <!-- Preview Dinâmico do comportamento.js será injetado aqui -->
                    <div id="preview-box" class="preview-container">
                        <img id="preview-img" src="" alt="Nova Foto">
                    </div>
                </div>
            </div>
            
            <button type="submit" class="btn btn-secondary col-full" style="width: 100%; margin-top: 20px;">
                <i class="fa-solid fa-save"></i> Atualizar Produto
            </button>
            <a href="/produtos/meus-produtos" class="btn btn-primary col-full" style="display: block; text-align: center; margin-top: 10px; text-decoration: none;">
                Cancelar Edição
            </a>
            
        </form>
    </div>
</div>

<%- include('partials/footer') %>
